# Client-side API endpoints
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5001/api
NEXT_PUBLIC_SALARY_API_URL=http://localhost:5002/api
NEXT_PUBLIC_STATS_API_URL=http://localhost:5004/api
NEXT_PUBLIC_VOTE_API_PROXY_PATH=/api/vote
NEXT_PUBLIC_SEARCH_API_PROXY_PATH=/api/search

# Server-side proxy targets for Next.js route handlers
VOTE_API_BASE_URL=http://127.0.0.1:5005/api
SEARCH_API_BASE_URL=http://127.0.0.1:5003/api