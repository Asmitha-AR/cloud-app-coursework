# Client-side API endpoints (browser makes these calls to host machine)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5001/api
NEXT_PUBLIC_SALARY_API_URL=http://localhost:5002/api
NEXT_PUBLIC_STATS_API_URL=http://localhost:5004/api
NEXT_PUBLIC_VOTE_API_PROXY_PATH=/api/vote
NEXT_PUBLIC_SEARCH_API_PROXY_PATH=/api/search

# Server-side proxy targets (Next.js server calls these - use Docker service names)
VOTE_API_BASE_URL=http://vote-service:8080/api
SEARCH_API_BASE_URL=http://search-service:8080/api